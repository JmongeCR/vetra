# stellar/soroban/Rust output
target
.soroban

# project identity and alias files will be in .config/stellar
.config

# test snapshot folders from sample contracts
test_snapshots

# build output
dist
dist-ssr

# dependencies
node_modules/

# logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# environment variables
.env
.env.*
!.env.example

# easy way to create temporary local-only files and folders
*.local.*

# macOS-specific files
.DS_Store

# generated contract bindings + clients (Binding packages and flattened index.ts)
# Ignore everything by default
app-lib/clients/**
# Keep the placeholder
!app-lib/clients/.gitkeep
# Commit the flattened index and the pre-built dist of each client package
# so Vercel can resolve workspace imports without running contracts:build
!app-lib/clients/index.ts
!app-lib/clients/reputation/
app-lib/clients/reputation/**
!app-lib/clients/reputation/package.json
!app-lib/clients/reputation/dist/
app-lib/clients/reputation/dist/**
!app-lib/clients/reputation/dist/index.js
!app-lib/clients/reputation/dist/index.d.ts
!app-lib/clients/pet_identity/
app-lib/clients/pet_identity/**
!app-lib/clients/pet_identity/package.json
!app-lib/clients/pet_identity/dist/
app-lib/clients/pet_identity/dist/**
!app-lib/clients/pet_identity/dist/index.js
!app-lib/clients/pet_identity/dist/index.d.ts

# Agent harness local-only state (skills and shared config ARE committed)
.claude/settings.local.json
.claude/worktrees/
.claude/launch.json

# TypeScript incremental build info
*.tsbuildinfo
.vercel
