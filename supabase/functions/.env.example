# Supabase Edge Functions — secrets for local development
# Copy this file to supabase/functions/.env and fill in the values.
# supabase/functions/.env is gitignored — never commit real keys.
#
# For production, set via (SUPABASE_ prefix is reserved and cannot be set):
#   supabase secrets set JWT_SECRET=<value>
#
# The following are injected automatically — DO NOT set them manually:
#   SUPABASE_URL             (auto)
#   SUPABASE_SERVICE_ROLE_KEY (auto)

# Settings → API → JWT Settings → JWT Secret
# Secret name: JWT_SECRET (not SUPABASE_JWT_SECRET — that prefix is reserved)
JWT_SECRET=
